# Google (Phase 0+)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_SHEET_ID=<your-sheet-id>
GMAIL_USER=<owner-email>
PROCESSED_LABEL=inventory-processed

# Anthropic (Phase 1+ for parser fallback, Phase 2+ for agents)
ANTHROPIC_API_KEY=

# Telegram (Phase 1 for digests, Phase 2+ for bot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_AUTHORIZED_CHAT_IDS=<comma-separated chat IDs allowed to talk to the bot; single user = your own chat ID>

# Outdoor integrations
PIRATE_WEATHER_API_KEY=               # Phase 3 (forecasts; Nominatim geocoder is keyless)
RECGOV_API_KEY=                       # Phase 5 (Recreation.gov RIDB API key — request at https://ridb.recreation.gov/)
CAMPING_INDEX_PATH=/data/camping-index.json
CAMPING_TRIPS_PATH=/data/camping-trips.json
DISPERSED_SNAPSHOT_PATH=/data/dispersed-snapshot.json     # USFS + BLM + (optional OSM) merged snapshot
DISPERSED_URL_CACHE_PATH=/data/dispersed-url-cache.json   # Persistent cache for scripts/seed-dispersed.ts URL resolutions
# Comma-separated list of dispersed-camping sources to fetch. Default is
# USFS,BLM. OSM is opt-in because ~14k Western-US community-tagged points
# are noisy at this scale — re-enable with USFS,BLM,OSM if needed.
DISPERSED_SOURCES=USFS,BLM

# Web dashboard (Phase 6) — HTTP Basic Auth credentials. Leave unset locally
# to disable auth in dev. Both must be set on the Railway Web service.
WEB_USER=
WEB_PASSWORD=

# Item images (Web UI v1.1) — local paths on the Railway /data volume.
# The Web service needs /data mounted (Railway dashboard) to read images;
# the Cron + Bot services need the same volume to write them. Defaults to
# ./local-data in dev. Don't put real Railway paths in this file — actual
# values are set on each service in the Railway dashboard.
IMAGE_STORAGE_ROOT=/data
IMAGE_URL_CACHE_PATH=/data/image-url-cache.json

# Image-search provider for backfill Phase 3 + cron resolveImage chain.
# Two providers supported; readImageSearchEnv() prefers Brave if set.
#
# Brave Search Image API (RECOMMENDED — Google CSE was closed to new
# customers in 2026):
#   Setup: api.search.brave.com/app/dashboard → subscribe to Free plan
#   (2000/mo, no card) → copy API key.
BRAVE_API_KEY=
#
# Google Custom Search JSON API (legacy fallback). NOTE: Google has
# closed this API to new customers — these will 403 unless your account
# has prior access. Kept only for accounts that already had it working.
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

# App config
TZ=America/Denver
DRY_RUN=false

# Cron only processes emails received on/after this date (YYYY-MM-DD).
# Set to a date when your sheet is "complete" through that point. Emails
# before this date should be bulk-labeled via `npm run label-historical`
# so the cron query skips them. Defaults to "30d ago" if unset.
INGEST_AFTER_DATE=2026-04-15
