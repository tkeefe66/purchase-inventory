    "next": "^14.2.18",
    "node-telegram-bot-api": "^0.66.0",
    "proper-lockfile": "^4.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3",
    "suncalc": "^1.9.0"
